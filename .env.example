# RAVO OS Environment Variables
# Copy this file to .env.local and fill in your credentials
#
# OBRIGATÓRIO: sem essas duas variáveis o app NÃO compila (fail-fast no build).

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mock data (APENAS desenvolvimento - nunca em produção)
# Quando true, os hooks usam dados fake de useMockData.ts em vez do Supabase.
# Não há mais fallback automático: erros reais aparecem na UI.
# VITE_USE_MOCK=true
